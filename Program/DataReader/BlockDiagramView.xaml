<UserControl x:Class="DataHandler.BlockDiagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DataHandler"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="940"
             Background="{DynamicResource DiagramBgBrush}">

    <UserControl.Resources>
        <!-- stile per evidenziare i bordi dei componenti quando ci si passa sopra col mouse -->
        <Style x:Key="BarePNGComponentStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OuterBorder" 
                                Background="Transparent" 
                                BorderBrush="Transparent" 
                                BorderThickness="1.5" 
                                CornerRadius="12" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#0A84FF"/>
                                <Setter TargetName="OuterBorder" Property="Background" Value="#1A0A84FF"/>
                                <Setter TargetName="OuterBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.9" Color="#0A84FF"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OuterBorder" Property="Background" Value="#330A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Intestazione schema e legenda -->
        <Border Grid.Row="0" Style="{StaticResource iOSCardStyle}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="SCHEMA A BLOCCHI COMPONENTI E PIN ESP32" FontWeight="Bold" FontSize="13" Foreground="#64D2FF"/>
                    <TextBlock Text="Schema di collegamento hardware con pin ESP32 (VCC, GND, TX, RX, A0, A1, A2, I2C)." 
                               Foreground="#8E99A8" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Border Background="#102B1D" BorderBrush="#1A5333" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock Text="OPERATIVO" Foreground="#30D158" FontWeight="Bold" FontSize="10"/>
                    </Border>
                    <Border Background="#2B2312" BorderBrush="#4A3D1E" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock Text="WARNING" Foreground="#FFD60A" FontWeight="Bold" FontSize="10"/>
                    </Border>
                    <Border Background="#2E1616" BorderBrush="#522424" BorderThickness="1" CornerRadius="6" Padding="8,3">
                        <TextBlock Text="ERRORE" Foreground="#FF453A" FontWeight="Bold" FontSize="10"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Canvas del diagramma e pannello dettagli -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <!-- Canvas dove disegniamo i collegamenti e i componenti -->
            <Border Grid.Column="0" Style="{StaticResource iOSCardStyle}" Padding="10" Margin="0,0,14,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas Width="650" Height="530" x:Name="DiagramCanvas">

                        <!-- Cavi di collegamento verdi -->
                        
                        <!-- Collegamento batteria a VCC e GND -->
                        <Path Data="M 155,75 L 205,75 L 205,175 L 285,175" Stroke="{Binding BatteryOk, Converter={x:Static local:BoolToBrushConverter.Instance}}" StrokeThickness="2.5"/>
                        <Path Data="M 155,82 L 195,82 L 195,188 L 285,188" Stroke="{Binding BatteryOk, Converter={x:Static local:BoolToBrushConverter.Instance}}" StrokeThickness="2.5"/>

                        <!-- Collegamento PC a TX -->
                        <Path Data="M 140,265 L 205,265 L 245,225 L 285,225" Stroke="{Binding IsConnected, Converter={x:Static local:StatusToBrushConverter.Instance}}" StrokeThickness="2.5" StrokeDashArray="4 2"/>

                        <!-- Collegamenti sensore ACC a RX e GND -->
                        <Path Data="M 215,385 L 250,385 L 250,238 L 285,238" Stroke="{Binding AccOk, Converter={x:Static local:BoolToBrushConverter.Instance}}" StrokeThickness="2"/>
                        <Path Data="M 215,398 L 255,398 L 255,251 L 285,251" Stroke="{Binding AccOk, Converter={x:Static local:BoolToBrushConverter.Instance}}" StrokeThickness="2"/>
                        <Path Data="M 215,411 L 260,411 L 260,264 L 285,264" Stroke="{Binding AccOk, Converter={x:Static local:BoolToBrushConverter.Instance}}" StrokeThickness="2"/>
                        <Path Data="M 215,424 L 265,424 L 265,277 L 285,277" Stroke="{Binding AccOk, Converter={x:Static local:BoolToBrushConverter.Instance}}" StrokeThickness="2"/>
                        <Path Data="M 215,437 L 270,437 L 270,290 L 285,290" Stroke="{Binding AccOk, Converter={x:Static local:BoolToBrushConverter.Instance}}" StrokeThickness="2"/>

                        <!-- Collegamento antenna 1 ad A0 -->
                        <Path Data="M 395,175 L 450,175 L 450,115 L 515,115" Stroke="{Binding Antenna1Ok, Converter={x:Static local:BoolToBrushConverter.Instance}}" StrokeThickness="2.5"/>

                        <!-- Collegamento antenna 2 ad A1 -->
                        <Path Data="M 395,225 L 440,225 L 440,270 L 515,270" Stroke="{Binding Antenna2Ok, Converter={x:Static local:BoolToBrushConverter.Instance}}" StrokeThickness="2.5"/>

                        <!-- Collegamento antenna 3 ad A2 -->
                        <Path Data="M 395,265 L 460,265 L 460,455 L 515,455" Stroke="{Binding Antenna3Ok, Converter={x:Static local:BoolToBrushConverter.Instance}}" StrokeThickness="2.5"/>


                        <!-- Scritte pin ESP32 -->
                        <!-- Pin sinistri -->
                        <TextBlock Canvas.Left="252" Canvas.Top="167" Text="VCC" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Canvas.Left="250" Canvas.Top="180" Text="GND" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Canvas.Left="260" Canvas.Top="217" Text="TX" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Canvas.Left="260" Canvas.Top="230" Text="RX" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Canvas.Left="250" Canvas.Top="244" Text="GND" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Canvas.Left="250" Canvas.Top="257" Text="GND" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>

                        <!-- Pin destri -->
                        <TextBlock Canvas.Left="402" Canvas.Top="167" Text="A0" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Canvas.Left="402" Canvas.Top="217" Text="A1" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Canvas.Left="402" Canvas.Top="257" Text="A2" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>


                        <!-- Componenti fisici (oggetti PNG trasparenti) -->

                        <!-- Batteria in alto a sinistra -->
                        <Button Canvas.Left="45" Canvas.Top="15" Style="{StaticResource BarePNGComponentStyle}" Click="Block_Click" Tag="Batteria">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="Assets/battery.png" Width="105" Height="65" Stretch="Uniform"/>
                                    <TextBlock Text="BATTERIA" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding BatteryVoltage, StringFormat={}{0:F2} V}" Foreground="#30D158" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Border Visibility="{Binding BatteryOk, Converter={x:Static local:InverseBoolToVisConverter.Instance}}" 
                                        Background="#FF453A" CornerRadius="9" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2">
                                    <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- PC seriale al centro-sinistra -->
                        <Button Canvas.Left="25" Canvas.Top="210" Style="{StaticResource BarePNGComponentStyle}" Click="Block_Click" Tag="Interfaccia PC">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/pc.png" Width="105" Height="75" Stretch="Uniform"/>
                                <TextBlock Text="PC (Seriale)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SelectedPort}" Foreground="#64D2FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Sensore ACC in basso a sinistra -->
                        <Button Canvas.Left="60" Canvas.Top="360" Style="{StaticResource BarePNGComponentStyle}" Click="Block_Click" Tag="ACC">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="Assets/acc_sensor.png" Width="85" Height="85" Stretch="Uniform"/>
                                    <TextBlock Text="SENSORE ACC" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding AccStatusText}" Foreground="{Binding AccOk, Converter={x:Static local:BoolToBrushConverter.Instance}}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Etichette pin lato destro del sensore -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="6,5,0,0">
                                    <TextBlock Text="SDA" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBlock Text="SCL" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBlock Text="I2C" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBlock Text="EGS" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBlock Text="GND" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>

                                <Border Visibility="{Binding AccOk, Converter={x:Static local:InverseBoolToVisConverter.Instance}}" Grid.ColumnSpan="2"
                                        Background="#FFD60A" CornerRadius="9" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2">
                                    <TextBlock Text="!" Foreground="Black" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- ESP32 al centro -->
                        <Button Canvas.Left="285" Canvas.Top="140" Style="{StaticResource BarePNGComponentStyle}" Click="Block_Click" Tag="ESP32">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="Assets/esp32.png" Width="105" Height="145" Stretch="Uniform"/>
                                    <TextBlock Text="ESP32" Foreground="#64D2FF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding OperatingStatus}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Border Visibility="{Binding MicrocontrollerOk, Converter={x:Static local:InverseBoolToVisConverter.Instance}}" 
                                        Background="#FF453A" CornerRadius="9" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2">
                                    <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Antenna 1 in alto a destra -->
                        <Button Canvas.Left="500" Canvas.Top="15" Style="{StaticResource BarePNGComponentStyle}" Click="Block_Click" Tag="Antenna 1 (3MHz)">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="Assets/antenna.png" Width="60" Height="80" Stretch="Uniform"/>
                                    <TextBlock Text="ANTENNA 1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="3 MHz (A0)" Foreground="#30D158" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Border Visibility="{Binding Antenna1Ok, Converter={x:Static local:InverseBoolToVisConverter.Instance}}" 
                                        Background="#FF453A" CornerRadius="9" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2">
                                    <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Antenna 2 al centro a destra -->
                        <Button Canvas.Left="500" Canvas.Top="170" Style="{StaticResource BarePNGComponentStyle}" Click="Block_Click" Tag="Antenna 2 (10MHz)">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="Assets/antenna.png" Width="60" Height="80" Stretch="Uniform"/>
                                    <TextBlock Text="ANTENNA 2" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="10 MHz (A1)" Foreground="#30D158" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Border Visibility="{Binding Antenna2Ok, Converter={x:Static local:InverseBoolToVisConverter.Instance}}" 
                                        Background="#FF453A" CornerRadius="9" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2">
                                    <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Antenna 3 in basso a destra -->
                        <Button Canvas.Left="500" Canvas.Top="355" Style="{StaticResource BarePNGComponentStyle}" Click="Block_Click" Tag="Antenna 3 (24MHz)">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="Assets/antenna.png" Width="60" Height="80" Stretch="Uniform"/>
                                    <TextBlock Text="ANTENNA 3" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="24 MHz (A2)" Foreground="#30D158" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Border Visibility="{Binding Antenna3Ok, Converter={x:Static local:InverseBoolToVisConverter.Instance}}" 
                                        Background="#FF453A" CornerRadius="9" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2">
                                    <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                    </Canvas>
                </ScrollViewer>
            </Border>

            <!-- Pannello laterale per i dettagli del componente cliccato -->
            <Border Grid.Column="1" Style="{StaticResource iOSCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DETTAGLIO COMPONENTE" FontWeight="Bold" FontSize="12" Foreground="#64D2FF" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedBlock}">
                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Type}" Foreground="#8E99A8" FontSize="11" Margin="0,0,0,10"/>
                            <Border Background="#1E2333" BorderBrush="#2C344A" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="STATO: " Foreground="#8E99A8" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Informazioni:" Foreground="#8E99A8" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Details, Mode=OneWay}" Background="Transparent" Foreground="#FFFFFF" 
                                     BorderThickness="0" TextWrapping="Wrap" IsReadOnly="True" FontSize="11" FontFamily="{DynamicResource MonospaceFont}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Margin="0,15,0,0">
                        <StackPanel>
                            <Border Height="1" Background="#262A3B" Margin="0,0,0,10"/>
                            <TextBlock Text="Stato telemetria in tempo reale." Foreground="#8E99A8" FontSize="11" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="* Passa sopra un componente per evidenziarne i bordi ed il bagliore azzurro." 
                   Foreground="#8E99A8" FontSize="10" Margin="0,8,0,0"/>
    </Grid>
</UserControl>

<Window x:Class="DataHandler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataHandler"
        mc:Ignorable="d"
        Title="MICROCONTROLLER MONITOR - ESP32" Height="820" Width="1080"
        MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource MainFont}">

    <Window.Resources>
        <local:BoolToVisConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
    </Window.Resources>

    <!-- Contenitore principale della finestra con bordi arrotondati -->
    <Border CornerRadius="20" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="10" Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra in alto trascinabile -->
            <Border Grid.Row="0" Background="{DynamicResource CardHeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,12" CornerRadius="14" Margin="0,0,0,16" MouseDown="TitleBar_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.15" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Titolo e bottone di chiusura rosso -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <!-- Pallino rosso per chiudere -->
                        <Button Width="18" Height="18" Margin="0,0,16,0" Click="WindowClose_Click" Cursor="Hand" ToolTip="Chiudi programma">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="18" Height="18">
                                        <Ellipse x:Name="circle" Fill="#FF453A" Width="18" Height="18">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4" Color="#FF453A"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Line x:Name="line1" X1="5.5" Y1="5.5" X2="12.5" Y2="12.5" 
                                                  Stroke="#FFFFFF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9"/>
                                            <Line x:Name="line2" X1="12.5" Y1="5.5" X2="5.5" Y2="12.5" 
                                                  Stroke="#FFFFFF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9"/>
                                        </Canvas>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="circle" Property="Fill" Value="#FF3B30"/>
                                            <Setter TargetName="line1" Property="Opacity" Value="1.0"/>
                                            <Setter TargetName="line2" Property="Opacity" Value="1.0"/>
                                            <Setter TargetName="line1" Property="StrokeThickness" Value="1.9"/>
                                            <Setter TargetName="line2" Property="StrokeThickness" Value="1.9"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="circle" Property="Fill" Value="#D70015"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Titolo app e crediti -->
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="#10253B" BorderBrush="#1A4A75" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="10,0,0,0">
                                    <TextBlock Text="ESP32" FontSize="11" FontWeight="Bold" Foreground="#64D2FF"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Created by prog. Francesco Frassinelli e aiuto Salvadri Francesco" 
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" FontStyle="Italic"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Selezione COM e Switch Tema -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Stato della scheda -->
                        <Border Background="#102B1D" BorderBrush="#1A5333" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,14,0">
                            <TextBlock Text="{Binding OperatingStatus}" FontWeight="Bold" FontSize="11" Foreground="#30D158" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Menu a tendina per la COM -->
                        <Border Background="{DynamicResource ComboBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,3" CornerRadius="8" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="COM: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort, Mode=TwoWay}" 
                                          Style="{StaticResource DarkComboBoxStyle}" Width="85" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ConnectionStatus}" FontWeight="Bold" FontSize="11" Foreground="{Binding ConnectionBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Switch tema chiaro/scuro -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ThemeToggleText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ToggleButton IsChecked="{Binding IsDarkMode, Mode=TwoWay}" Style="{StaticResource iOSToggleSwitchStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Selettore schede principale -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Style="{StaticResource iOSSegmentedContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="PANORAMICA MONITOR" IsChecked="{Binding SelectedTabIndex, Converter={x:Static local:TabToBoolConverter.Instance}, ConverterParameter=0}" 
                                     Style="{StaticResource iOSSegmentedButtonStyle}"/>
                        <RadioButton Content="SCHEMA A BLOCCHI" IsChecked="{Binding SelectedTabIndex, Converter={x:Static local:TabToBoolConverter.Instance}, ConverterParameter=1}" 
                                     Style="{StaticResource iOSSegmentedButtonStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Viste del programma -->
            <Grid Grid.Row="2">

                <!-- Scheda 1: Panoramica e Dashboard -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={x:Static local:TabToVisConverter.Instance}, ConverterParameter=0}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sezione Batteria e Stato Hardware -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Box Batteria -->
                        <Border Grid.Column="0" Style="{StaticResource iOSCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="BATTERIA &amp; ALIMENTAZIONE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                                <!-- Indicatore carica batteria -->
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BatteryPercentage, StringFormat={}{0:F0}%}" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>

                                    <Border Width="175" Height="36" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="2" CornerRadius="8" Padding="3" Margin="0,10,0,14" HorizontalAlignment="Center">
                                        <Grid>
                                            <Border Width="5" Height="14" Background="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" Margin="0,0,-8,0" CornerRadius="0,3,3,0"/>

                                            <Rectangle Width="{Binding BatteryBarWidth}" HorizontalAlignment="Left" RadiusX="4" RadiusY="4">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#30D158" Offset="0.0"/>
                                                        <GradientStop Color="#64D2FF" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Valori di tensione -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Border Background="{DynamicResource CardHeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Tensione: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding BatteryVoltage, StringFormat={}{0:F2} V}" FontSize="13" FontWeight="Bold" Foreground="#30D158"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <Border Background="{DynamicResource CardHeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ADC: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding AdcVoltage, StringFormat={}{0:F2} V}" FontSize="13" FontWeight="Bold" Foreground="#64D2FF"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Box Stato Hardware -->
                        <Border Grid.Column="2" Style="{StaticResource iOSCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="STATO SISTEMA HARDWARE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                <!-- Elenco componenti di sistema -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="6,0">
                                    
                                    <!-- Microcontrollore -->
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Microcontrollore" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Background="#102B1D" BorderBrush="#1A5333" BorderThickness="1" CornerRadius="6" Padding="10,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding MicrocontrollerText}" Foreground="{Binding MicrocontrollerOk, Converter={x:Static local:BoolToBrushConverter.Instance}}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>

                                    <!-- Batteria -->
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Batteria" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Background="#102B1D" BorderBrush="#1A5333" BorderThickness="1" CornerRadius="6" Padding="10,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding BatteryStatusText}" Foreground="{Binding BatteryOk, Converter={x:Static local:BoolToBrushConverter.Instance}}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>

                                    <!-- ACC -->
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Sensore ACC" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Background="#102B1D" BorderBrush="#1A5333" BorderThickness="1" CornerRadius="6" Padding="10,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding AccStatusText}" Foreground="{Binding AccOk, Converter={x:Static local:BoolToBrushConverter.Instance}}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>

                                    <!-- Antenna 1 -->
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Antenna 1 (3 MHz)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Background="#102B1D" BorderBrush="#1A5333" BorderThickness="1" CornerRadius="6" Padding="10,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Antenna1Text}" Foreground="{Binding Antenna1Ok, Converter={x:Static local:BoolToBrushConverter.Instance}}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>

                                    <!-- Antenna 2 -->
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Antenna 2 (10 MHz)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Background="#102B1D" BorderBrush="#1A5333" BorderThickness="1" CornerRadius="6" Padding="10,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Antenna2Text}" Foreground="{Binding Antenna2Ok, Converter={x:Static local:BoolToBrushConverter.Instance}}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,2"/>

                                    <!-- Antenna 3 -->
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Antenna 3 (24 MHz)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Background="#102B1D" BorderBrush="#1A5333" BorderThickness="1" CornerRadius="6" Padding="10,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Antenna3Text}" Foreground="{Binding Antenna3Ok, Converter={x:Static local:BoolToBrushConverter.Instance}}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Sezione Misure Radio -->
                    <Border Grid.Row="1" Style="{StaticResource iOSCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="MISURE ONDE RADIO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                            <UniformGrid Columns="4" Margin="0,3,0,0">
                                <!-- Frequenza -->
                                <Border Background="{DynamicResource CardHeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="FREQUENZA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FrequencyMhz, StringFormat={}{0:F0} MHz}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Ampiezza -->
                                <Border Background="{DynamicResource CardHeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="AMPIEZZA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Amplitude, StringFormat={}{0:F0}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Durata -->
                                <Border Background="{DynamicResource CardHeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DURATA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DurationSec, StringFormat={}{0:F2} s}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Banda -->
                                <Border Background="{DynamicResource CardHeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="BANDA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Band}" FontSize="20" FontWeight="Bold" Foreground="#64D2FF" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Registro Eventi -->
                    <Border Grid.Row="2" Style="{StaticResource iOSCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="REGISTRO EVENTI &amp; ERRORI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                            <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0" 
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardHeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{DynamicResource MonospaceFont}" FontSize="12" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Level}" Foreground="{Binding LevelBrush}" FontWeight="Bold" FontSize="10"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Scheda 2: Schema a Blocchi -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={x:Static local:TabToVisConverter.Instance}, ConverterParameter=1}">
                    <local:BlockDiagramView/>
                </Grid>

            </Grid>

            <!-- Piè di pagina -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <TextBlock Text="Rivelatore Onde HAARP - Monitor ESP32" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Left"/>
                <TextBlock Text="Trascina la barra in alto per spostare • Clicca il pulsante rosso ✕ per chiudere" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>

<Application x:Class="DataHandler.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- iOS Apple Dynamic Color Brushes -->
            <SolidColorBrush x:Key="WindowBgBrush" Color="#0A0B10" />
            <SolidColorBrush x:Key="CardBgBrush" Color="#161822" />
            <SolidColorBrush x:Key="CardHeaderBgBrush" Color="#1E2230" />
            <SolidColorBrush x:Key="BorderBrush" Color="#262A3B" />
            <SolidColorBrush x:Key="BorderHoverBrush" Color="#0A84FF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E99A8" />
            <SolidColorBrush x:Key="AccentBlueBrush" Color="#0A84FF" />
            <SolidColorBrush x:Key="AccentGreenBrush" Color="#30D158" />
            <SolidColorBrush x:Key="AccentCyanBrush" Color="#64D2FF" />
            <SolidColorBrush x:Key="AccentYellowBrush" Color="#FFD60A" />
            <SolidColorBrush x:Key="AccentRedBrush" Color="#FF453A" />
            <SolidColorBrush x:Key="ButtonBgBrush" Color="#1E2230" />
            <SolidColorBrush x:Key="ButtonHoverBgBrush" Color="#2A2E40" />
            <SolidColorBrush x:Key="DiagramBgBrush" Color="#0A0B10" />
            <SolidColorBrush x:Key="ComboBgBrush" Color="#1E2230" />

            <!-- Font Family -->
            <FontFamily x:Key="MainFont">Segoe UI Variable Display, Segoe UI, -apple-system, SF Pro Display, Helvetica Neue, Arial</FontFamily>
            <FontFamily x:Key="MonospaceFont">SF Pro Text, Consolas, Segoe UI Mono, Cascadia Code</FontFamily>

            <!-- iOS Dynamic Glassmorphic Card Style -->
            <Style x:Key="iOSCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="#000000" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- iOS Dynamic Segmented Control Container -->
            <Style x:Key="iOSSegmentedContainerStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardHeaderBgBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="3" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- iOS Dynamic Segmented Control Button -->
            <Style x:Key="iOSSegmentedButtonStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="Padding" Value="18,7" />
                <Setter Property="FontFamily" Value="{DynamicResource MainFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="7" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBgBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="#000000" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- iOS Toggle Switch Style -->
            <Style x:Key="iOSToggleSwitchStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="51" />
                <Setter Property="Height" Value="31" />
                <Setter Property="Background" Value="#39393D" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <!-- Track -->
                                <Border x:Name="Track" 
                                        Background="{TemplateBinding Background}" 
                                        CornerRadius="15.5" 
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1" />
                                
                                <!-- Thumb Knob -->
                                <Border x:Name="Thumb" 
                                        Width="27" Height="27" 
                                        Background="#FFFFFF" 
                                        CornerRadius="13.5" 
                                        HorizontalAlignment="Left" 
                                        Margin="2,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" Color="#000000" />
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTranslate" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#30D158" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbTranslate" 
                                                                 Storyboard.TargetProperty="X" 
                                                                 To="20" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbTranslate" 
                                                                 Storyboard.TargetProperty="X" 
                                                                 To="0" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom Dynamic iOS ComboBox Style -->
            <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource ComboBgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontFamily" Value="{DynamicResource MainFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid x:Name="MainGrid">
                                <Border x:Name="Border" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <ContentPresenter Margin="{TemplateBinding Padding}" 
                                                          Content="{TemplateBinding SelectionBoxItem}" 
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          VerticalAlignment="Center" 
                                                          HorizontalAlignment="Left" />
                                        
                                        <Path x:Name="Arrow" Grid.Column="1" 
                                              Data="M 0 0 L 4 4 L 8 0 Z" 
                                              Fill="{DynamicResource TextSecondaryBrush}" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Popup x:Name="PART_Popup" 
                                       AllowsTransparency="True" 
                                       IsOpen="{TemplateBinding IsDropDownOpen}" 
                                       Placement="Bottom" 
                                       PopupAnimation="Slide">
                                    <Border x:Name="DropDownBorder" 
                                            Background="{DynamicResource ComboBgBrush}" 
                                            BorderBrush="{DynamicResource BorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="10" 
                                            Margin="0,4,0,0"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" Color="#000000" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#0A84FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dynamic ComboBoxItem Style -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontFamily" Value="{DynamicResource MainFont}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="6"
                                    Margin="2,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}" />
                                    <Setter Property="Foreground" Value="#64D2FF" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#0A84FF" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Smooth Dynamic iOS Button Style -->
            <Style x:Key="iOSButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontFamily" Value="{DynamicResource MainFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="10" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#0A84FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
